# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-flash returns 404 for new API keys; use a current model
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated fallback models (tried only if the primary fails after retries)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# true = simulated evaluation without calling Gemini (local tests only)
GEMINI_DRY_RUN=false

# Trust the OS certificate store (needed when an antivirus/proxy re-signs HTTPS, e.g. Avast Web Shield)
USE_SYSTEM_CERTS=true

# Job criteria (target: async freelance QA, 5-10 h/week, 20-35 USD/h, global market)
MIN_HOURLY_RATE=20
TARGET_HOURLY_RATE_RANGE=20-35
MAX_HOURS_PER_WEEK=20
# Full-time remote accepted only if contractor/async friendly and pays >= MIN_FULLTIME_ANNUAL_USD
ALLOW_FULL_TIME=true
MIN_FULLTIME_ANNUAL_USD=45000
# Minimum budget (USD) for fixed-price projects
MIN_PROJECT_BUDGET=50

# India / APAC market (disabled by default)
ALLOW_INDIA_JOBS=false
MIN_INDIA_HOURLY_RATE=8

# Enabled sources (comma separated)
# Options: freelancer, remotive, jobicy, remoteok, himalayas, weworkremotely, hasjob, arbeitnow
ENABLED_SOURCES=freelancer,remotive,jobicy,remoteok,himalayas,weworkremotely,arbeitnow

# Extra custom RSS / Atom feeds (optional, comma separated)
CUSTOM_JOB_FEEDS=
